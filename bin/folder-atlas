#!/bin/sh
# folder-atlas: is it safe to delete this folder on a Mac?
#
# Part of the Mac Folder Atlas, https://github.com/siftmac/mac-folder-atlas
# Code: MIT licence. Answers: CC BY 4.0, Mac Folder Atlas (siftmac.com).
#
# bin/folder-atlas is generated by scripts/sync.py from src/folder-atlas.sh: edit that, not bin/.
# Plain POSIX sh and the awk that comes with macOS, so it runs on any Mac with nothing to install.

VERSION=1.0.0
DATA_DATE=2026-11-21
COUNT=93
ME=folder-atlas
REPO=https://github.com/siftmac/mac-folder-atlas

usage() {
	cat <<EOF
$ME: is it safe to delete this folder on a Mac?

Usage:
  $ME <path>...      the verdict, a short answer and the full answer's link
  $ME <name>         find by name, such as: $ME docker
  $ME -m <path>      more: the whole short answer, how to measure it and clear it, sources
  $ME -l             list all $COUNT folders in the Atlas
  $ME -j <path>...   JSON, one object per line
  $ME -o <path>      also open the full answer in your browser

A path can be inside a known folder (~/Library/Caches/com.example.app), relative,
or start with ~. Several paths, or a glob like ~/Library/Caches/*, give one line each.

Verdicts:
  Rebuilds    comes back by itself; clearing it costs time or a download, not your data
  Safe        logs and leftovers nobody needs
  You decide  yours to judge: it doesn't come back, or only by downloading or making it again
  Leave it    leave it to macOS or the app

Options:
  -m, --more    -l, --list    -j, --json    -o, --open
  --no-color    -h, --help    -V, --version

Answers: Mac Folder Atlas (siftmac.com), CC BY 4.0. $REPO
EOF
}

# The lookup, the matching and the printing. Reads the data, then the queries, from standard input.
# shellcheck disable=SC2016 # awk code, not shell
PROG='
function norm(s) {
	s = tolower(s)
	gsub(/[^a-z0-9]+/, " ", s)
	sub(/^ /, "", s)
	sub(/ $/, "", s)
	return s
}
function resc(s) {
	gsub(/[][\\.^$|?*+(){}]/, "\\\\&", s)
	return s
}
function shq(s,   n, p, i, o) {
	n = split(s, p, SQ)
	o = SQ p[1]
	for (i = 2; i <= n; i++) o = o SQ "\\" SQ SQ p[i]
	return o SQ
}
function isfile(f) { return system("test -f " shq(f)) == 0 }
function jstr(s) {
	gsub(/\\/, "\\\\", s)
	gsub(/"/, "\\\"", s)
	gsub(/\t/, "\\t", s)
	return "\"" s "\""
}
function dirname(f,   k) {
	k = match(f, /\/[^\/]*$/)
	return k > 1 ? substr(f, 1, k - 1) : "/"
}
function isword(a) { return a !~ /\// && a !~ /^~/ && a != "." && a != ".." }

# A path as the user typed it to a clean absolute one.
function normalize(p,   n, parts, out, i, k, s) {
	if (p == "~") p = home
	else if (substr(p, 1, 2) == "~/") p = home substr(p, 2)
	else if (substr(p, 1, 1) == "~") p = "/Users/" substr(p, 2)
	else if (substr(p, 1, 1) != "/") p = pwd "/" p
	n = split(p, parts, "/")
	split("", out)
	k = 0
	for (i = 1; i <= n; i++) {
		if (parts[i] == "" || parts[i] == ".") continue
		if (parts[i] == "..") { if (k > 0) k--; continue }
		out[++k] = parts[i]
	}
	s = ""
	for (i = 1; i <= k; i++) s = s "/" out[i]
	if (s == "") s = "/"
	if (s ~ /^\/(var|tmp|etc)(\/|$)/) s = "/private" s
	if (s ~ /^\/System\/Volumes\/Data\/(Users|Library|Applications|Volumes|private|opt|cores|usr\/local|System\/Library\/(Caches|Assets|AssetsV2))(\/|$)/) s = substr(s, 21)
	return s
}
# The home folder a path is under: yours, or another account in /Users.
function homeof(p,   u) {
	if (home != "" && (p == home || index(p, home "/") == 1)) return home
	if (match(p, /^\/Users\/[^\/]+/)) {
		u = substr(p, 8, RLENGTH - 7)
		if (u != "Shared" && u != "Deleted Users") return substr(p, 1, RLENGTH)
	}
	return ""
}
function tilde(p, h) {
	if (h != "" && p == h) return "~"
	if (h != "" && index(p, h "/") == 1) return "~" substr(p, length(h) + 1)
	return p
}
# The entry for a path: the rule whose match ends deepest in it; ties go to the more specific rule.
function best(p, h,   i, rx, e, folder, bend, bw) {
	bid = ""; bfolder = ""; bend = -1; bw = -1
	for (i = 1; i <= nm; i++) {
		if (needle[i] != "" && index(p, needle[i]) == 0) continue
		if (anc[i] == "~") { if (h == "") continue; rx = "^" resc(h) re[i] }
		else rx = re[i]
		if (!match(p, rx)) continue
		e = RSTART + RLENGTH - 1
		if (e > 1 && substr(p, e, 1) == "/") e--
		folder = substr(p, 1, e)
		if (beside[i] != "" && !isfile(dirname(folder) "/" beside[i])) continue
		if (has[i] != "" && !isfile(folder "/" has[i])) continue
		if (e > bend || (e == bend && weight[i] > bw)) { bend = e; bw = weight[i]; bid = mid[i]; bfolder = folder; brule = i }
	}
	return bid
}
function search(a, i,   w, j, id) {
	w = norm(a)
	rn[i] = 0
	if (w == "") return 0
	for (j = 1; j <= nf; j++) {
		id = ids[j]
		if (index(" " hay[id] " ", " " w) > 0) rl[i, ++rn[i]] = id
	}
	return rn[i]
}
function resolve(i,   a, p, id) {
	a = q[i]
	p = normalize(a)
	rpath[i] = p
	rhome[i] = homeof(p)
	id = best(p, rhome[i])
	if (isword(a) && !qexists[i] && !(id != "" && bfolder == p)) {
		if (search(a, i) > 0) { rkind[i] = "search"; return }
	}
	if (id != "") {
		rid[i] = id
		rfolder[i] = bfolder
		rkind[i] = (bfolder == p) ? "path" : "inside"
		rv[i] = mverdict[brule] != "" ? mverdict[brule] : verdict[id]
		rlab[i] = mverdict[brule] != "" ? mlabel[brule] : label[id]
		rnote[i] = mnote[brule]
		return
	}
	rkind[i] = "none"
	status = 1
}

# ---------- printing ----------
function vlen(s) {
	gsub(/\033\[[0-9;]*m/, "", s)
	gsub(/[\200-\277]/, "", s)
	return length(s)
}
function pad(s, n,   k) {
	for (k = vlen(s); k < n; k++) s = s " "
	return s
}
function spaces(n,   s) {
	s = ""
	while (n-- > 0) s = s " "
	return s
}
# **bold** and `code` marks to the terminal.
function render(s,   n, seg, i, out, t) {
	n = split(s, seg, "`")
	out = ""
	for (i = 1; i <= n; i++) {
		t = seg[i]
		if (i % 2 == 0) { out = out (color ? CODE t R0 : "`" t "`"); continue }
		while (match(t, /\*\*[^*]+\*\*/)) t = substr(t, 1, RSTART - 1) B substr(t, RSTART + 2, RLENGTH - 4) R0 substr(t, RSTART + RLENGTH)
		out = out t
	}
	return out
}
function wrap(s, first, rest,   n, w, i, line, len, wl, out, started) {
	if (width <= 0) return first s
	n = split(s, w, / +/)
	out = ""; line = first; len = vlen(first); started = 0
	for (i = 1; i <= n; i++) {
		if (w[i] == "") continue
		wl = vlen(w[i])
		if (started && len + 1 + wl > width) {
			out = out line "\n"
			line = rest w[i]
			len = vlen(rest) + wl
		} else {
			line = line (started ? " " : "") w[i]
			len += (started ? 1 : 0) + wl
		}
		started = 1
	}
	return out line
}
function vword(id) { return VC[verdict[id]] label[id] R0 }

function full(i, id,   t, line, k, kind, text, mark, insec) {
	if (rnote[i] != "") {
		print VC[rv[i]] rlab[i] R0 " " DIM "·" R0 " " B tilde(rfolder[i], rhome[i]) R0
		if (rkind[i] == "inside") print wrap(DIM substr(rpath[i], length(rfolder[i]) + 2) " is inside it." R0, "", "")
		print wrap(render(rnote[i]), "", "")
		if (!more) {
			print wrap(DIM "See “" name[id] "”:" R0 " " url[id], "", "")
			return
		}
		print ""
		print B "About " name[id] R0 " " DIM "(" vword(id) DIM ")" R0
	} else {
		line = vword(id) " " DIM "·" R0 " " B name[id] R0
		if ((rkind[i] == "path" || rkind[i] == "inside") && (qexists[i] || !isword(q[i]))) {
			t = tilde(rfolder[i], rhome[i])
			if (index(name[id], t) == 0) line = line ": " t
		}
		print line
		if (rkind[i] == "inside") print wrap(DIM substr(rpath[i], length(rfolder[i]) + 2) " is inside it." R0, "", "")
	}
	if (!more) {
		print wrap(render(answer[id]) " " DIM "Comes back?" R0 " " render(back[id]), "", "")
		print url[id]
		return
	}
	insec = 0
	for (k = 1; k <= nx[id]; k++) {
		kind = xt[id, k]; text = xs[id, k]
		if (kind == "h") { print ""; print B text R0; insec = 1 }
		else if (kind == "p") { if (!insec) print ""; print wrap(render(text), insec ? "  " : "", insec ? "  " : "") }
		else if (kind == "h3") print "  " B render(text) R0
		else if (kind == "li") {
			mark = text
			sub(/ .*/, "", mark)
			print wrap(render(text), "  ", spaces(3 + length(mark)))
		}
		else if (kind == "code") print "    " CODE text R0
		else if (kind == "src") print wrap(text, "  - ", "    ")
	}
	print ""
	print "Full answer: " url[id]
}
function row(id, where, note, v, lab,   s) {
	if (v == "") { v = verdict[id]; lab = label[id] }
	s = "  " VC[v] pad(lab, 10) R0 "  " pad(where, colw) "  " name[id]
	if (note != "") s = s " " DIM note R0
	print s
}
function searchlist(i,   k, id, w) {
	colw = 0
	for (k = 1; k <= rn[i]; k++) { w = vlen(tilde(first[rl[i, k]], "")); if (w > colw) colw = w }
	if (colw > 46) colw = 46
	print "\"" q[i] "\" matches " rn[i] " folders:"
	for (k = 1; k <= rn[i]; k++) { id = rl[i, k]; row(id, first[id], "") }
	print DIM "Look one up with " me " <path>, or see them all with " me " --list." R0
}
function children(i,   k, p, g, x, n, cid, cg, cr, seen, j, t1, t2, t3) {
	p = rpath[i]
	n = 0
	for (k = 1; k <= nm; k++) {
		g = glob[k]
		if (anc[k] == "~") { if (rhome[i] == "") continue; x = rhome[i] substr(g, 2) }
		else if (anc[k] == "/") x = g
		else continue
		if (!(p == "/" || index(x, p "/") == 1)) continue
		if (mid[k] in seen) continue
		seen[mid[k]] = 1
		n++
		cid[n] = mid[k]
		cg[n] = tilde(x, rhome[i])
		cr[n] = k
	}
	for (k = 2; k <= n; k++) {
		for (j = k; j > 1 && cg[j - 1] > cg[j]; j--) {
			t1 = cg[j]; cg[j] = cg[j - 1]; cg[j - 1] = t1
			t2 = cid[j]; cid[j] = cid[j - 1]; cid[j - 1] = t2
			t3 = cr[j]; cr[j] = cr[j - 1]; cr[j - 1] = t3
		}
	}
	if (n == 0) return 0
	colw = 0
	for (k = 1; k <= n; k++) if (vlen(cg[k]) > colw) colw = vlen(cg[k])
	if (colw > 46) colw = 46
	print n " known " (n == 1 ? "folder is" : "folders are") " inside it:"
	for (k = 1; k <= n; k++) row(cid[k], cg[k], "", mverdict[cr[k]], mlabel[cr[k]])
	return n
}
function none(i) {
	print tilde(rpath[i], rhome[i]) " isn" "\047" "t in the Atlas."
	if (!children(i)) {
		print DIM "See every folder with " me " --list. Missing one? Ask at " repo "/issues" R0
	}
}
function jsonline(i,   id, head, k) {
	if (rkind[i] == "path" || rkind[i] == "inside") {
		id = rid[i]
		head = "{\"query\":" jstr(q[i]) ",\"path\":" jstr(rpath[i]) ",\"found\":true,\"matched\":" jstr(tilde(rfolder[i], rhome[i])) ",\"inside\":" (rkind[i] == "inside" ? "true" : "false") ",\"folder_verdict\":" jstr(rv[i]) ",\"note\":" (rnote[i] == "" ? "null" : jstr(rnote[i])) ","
		print head substr(js[id], 2)
	} else if (rkind[i] == "search") {
		for (k = 1; k <= rn[i]; k++) {
			id = rl[i, k]
			print "{\"query\":" jstr(q[i]) ",\"path\":null,\"found\":true,\"matched\":null,\"inside\":false,\"folder_verdict\":" jstr(verdict[id]) ",\"note\":null," substr(js[id], 2)
		}
	} else print "{\"query\":" jstr(q[i]) ",\"path\":" jstr(rpath[i]) ",\"found\":false}"
}
function compact(   i, d, w, id, s, t) {
	colw = 0
	for (i = 1; i <= nq; i++) {
		d[i] = (isword(q[i]) && !qexists[i]) ? q[i] : tilde(rpath[i], rhome[i])
		w = vlen(d[i])
		if (w > colw) colw = w
	}
	if (colw > 48) colw = 48
	for (i = 1; i <= nq; i++) {
		if (rkind[i] == "path") row(rid[i], d[i], rnote[i] != "" ? "(see " me " " d[i] ")" : "", rv[i], rlab[i])
		else if (rkind[i] == "inside") {
			t = tilde(rfolder[i], rhome[i])
			row(rid[i], d[i], index(name[rid[i]], t) ? "(inside it)" : "(in " t ")", rv[i], rlab[i])
		}
		else if (rkind[i] == "search" && rn[i] == 1) row(rl[i, 1], d[i], "(by name)")
		else if (rkind[i] == "search") print "  " pad("", 10) "  " pad(d[i], colw) "  " DIM rn[i] " folders by this name: " me " " q[i] R0
		else print "  " DIM pad("?", 10) R0 "  " pad(d[i], colw) "  " DIM "not in the Atlas" R0
	}
}
function listall(   j, id, c, w) {
	colw = 0
	for (j = 1; j <= nf; j++) { w = vlen(first[ids[j]]); if (w > colw) colw = w }
	if (colw > 46) colw = 46
	c = ""
	for (j = 1; j <= nf; j++) {
		id = ids[j]
		if (cat[id] != c) { if (c != "") print ""; c = cat[id]; print B c R0 }
		row(id, first[id], "")
	}
	print ""
	print DIM nf " folders. Look one up with " me " <path>." R0
}

BEGIN {
	FS = "\t"
	SQ = "\047"
	pwd = ENVIRON["FA_PWD"]
	home = ENVIRON["FA_HOME"] == "" ? "" : normalize(ENVIRON["FA_HOME"])
	if (color) {
		B = "\033[1m"; DIM = "\033[2m"; R0 = "\033[0m"; CODE = "\033[36m"
		VC["rebuilds"] = "\033[1;32m"; VC["safe"] = "\033[1;32m"; VC["decide"] = "\033[1;33m"; VC["leave"] = "\033[1;31m"
	}
}
$1 == "F" { nf++; ids[nf] = $2; verdict[$2] = $3; label[$2] = $4; name[$2] = $5; cat[$2] = $6; url[$2] = $7; answer[$2] = $8; back[$2] = $9; first[$2] = $10; hay[$2] = norm($11); next }
$1 == "M" { nm++; mid[nm] = $2; anc[nm] = $3; needle[nm] = $4; weight[nm] = $5 + 0; re[nm] = $6; beside[nm] = $7; has[nm] = $8; glob[nm] = $9; mverdict[nm] = $10; mlabel[nm] = $11; mnote[nm] = $12; next }
$1 == "X" { k = ++nx[$2]; xt[$2, k] = $3; xs[$2, k] = $4; next }
$1 == "J" { js[$2] = substr($0, length($2) + 4); next }
$1 == "Q" { nq++; qexists[nq] = $2 + 0; q[nq] = substr($0, length($2) + 4); next }
END {
	if (list) { listall(); exit 0 }
	status = 0
	for (i = 1; i <= nq; i++) resolve(i)
	if (urls) {
		for (i = 1; i <= nq; i++) {
			if (rkind[i] == "path" || rkind[i] == "inside") print url[rid[i]]
			else if (rkind[i] == "search" && rn[i] == 1) print url[rl[i, 1]]
		}
		exit status
	}
	if (json) { for (i = 1; i <= nq; i++) jsonline(i); exit status }
	if (nq == 1 || more) {
		for (i = 1; i <= nq; i++) {
			if (i > 1) print ""
			if (rkind[i] == "path" || rkind[i] == "inside") full(i, rid[i])
			else if (rkind[i] == "search" && rn[i] == 1) full(i, rl[i, 1])
			else if (rkind[i] == "search") searchlist(i)
			else none(i)
		}
		exit status
	}
	compact()
	exit status
}
'

# Each query as one line for awk: Q, whether it exists here (for bare names), the query.
queries() {
	for a in "$@"; do
		e=0
		[ -e "$a" ] && e=1
		printf 'Q\t%s\t%s\n' "$e" "$a"
	done
}

run() { # run <urls 0|1> <query>...
	u=$1
	shift
	if [ "$list" = 1 ] || [ $# -gt 0 ]; then
		{ data; queries "$@"; }
	else
		{ data; while IFS= read -r line; do queries "$line"; done; }
	fi | FA_HOME=$HOME FA_PWD=$PWD awk -v list="$list" -v more="$more" -v json="$json" -v urls="$u" \
		-v color="$color" -v width="$width" -v me="$ME" -v repo="$REPO" "$PROG"
}

main() {
	more=0 list=0 json=0 open=0 color=
	n=$#
	while [ "$n" -gt 0 ]; do
		a=$1
		shift
		n=$((n - 1))
		case $a in
		-h | --help) usage; exit 0 ;;
		-V | --version) echo "$ME $VERSION (answers of $DATA_DATE, $COUNT folders)"; exit 0 ;;
		-m | --more) more=1 ;;
		-l | --list) list=1 ;;
		-j | --json) json=1 ;;
		-o | --open) open=1 ;;
		--no-color | --no-colour) color=0 ;;
		--color | --colour) color=1 ;;
		--)
			while [ "$n" -gt 0 ]; do set -- "$@" "$1"; shift; n=$((n - 1)); done
			;;
		-[mljo][mljo]*)
			f=${a#-}
			while [ -n "$f" ]; do
				case $f in m*) more=1 ;; l*) list=1 ;; j*) json=1 ;; o*) open=1 ;; esac
				f=${f#?}
			done
			;;
		-?*) echo "$ME: unknown option $a (see $ME --help)" >&2; exit 2 ;;
		*) set -- "$@" "$a" ;;
		esac
	done

	if [ $# -eq 0 ] && [ "$list" = 0 ] && [ -t 0 ]; then
		usage
		exit 0
	fi
	if [ -z "$color" ]; then
		color=0
		[ -t 1 ] && [ -z "${NO_COLOR-}" ] && [ "${TERM-dumb}" != dumb ] && color=1
	fi
	width=0
	if [ -t 1 ]; then
		width=$(tput cols 2>/dev/null)
		case $width in '' | *[!0-9]*) width=80 ;; esac
		[ "$width" -gt 100 ] && width=100
		[ "$width" -lt 40 ] && width=40
	fi

	run 0 "$@"
	status=$?
	if [ "$open" = 1 ] && [ $# -gt 0 ] && [ "$json" = 0 ]; then
		run 1 "$@" | while IFS= read -r u; do open "$u"; done
	fi
	exit "$status"
}

data() {
	cat <<'ATLAS_DATA'
F	application-support	leave	Leave it	App data (Application Support)	Library and system	https://siftmac.com/safe-to-delete/application-support	**No, not as a whole.**	Only as an empty folder.	~/Library/Application Support	application-support App data (Application Support) Library and system ~/Library/Application Support /Library/Application Support
F	diagnostic-reports	safe	Safe	Crash reports (DiagnosticReports)	Library and system	https://siftmac.com/safe-to-delete/diagnostic-reports	**Yes.** Every file in it is a report macOS wrote after something crashed, hung or ran into trouble.	Only when something fails again.	~/Library/Logs/DiagnosticReports	diagnostic-reports Crash reports (DiagnosticReports) Library and system ~/Library/Logs/DiagnosticReports /Library/Logs/DiagnosticReports
F	document-revisions	leave	Leave it	Document versions (.DocumentRevisions-V100)	Library and system	https://siftmac.com/safe-to-delete/document-revisions	**Leave the folder itself.**	Yes: macOS keeps saving versions as you work, every hour and whenever you save, rename or duplicate a document.	/System/Volumes/Data/.DocumentRevisions-V100	document-revisions Document versions (.DocumentRevisions-V100) Library and system /System/Volumes/Data/.DocumentRevisions-V100
F	fseventsd	leave	Leave it	File change logs (.fseventsd)	Library and system	https://siftmac.com/safe-to-delete/fseventsd	**No, leave it.** `.fseventsd` is macOS’s running record of which folders changed on a disk.	At once: macOS’s `fseventsd` service keeps writing it as files change.	/System/Volumes/Data/.fseventsd	fseventsd File change logs (.fseventsd) Library and system /System/Volumes/Data/.fseventsd /Volumes/<drive>/.fseventsd
